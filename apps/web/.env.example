DATABASE_URL=postgres://postgres:postgres@localhost:5432/wyceny
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000
WORKER_URL=http://localhost:8000
# Passwords for the two seeded users (`pnpm seed`): aneta@wyceny.test (admin)
# and zenon@wyceny.test (appraiser). No defaults — the seed aborts if either is
# unset, which is what keeps them out of the repo. Re-running the seed with a
# new value rotates that account's password. Note: the seed reads `.env` (via
# dotenv), not `.env.local`.
SEED_ADMIN_PASSWORD=
SEED_APPRAISER_PASSWORD=
